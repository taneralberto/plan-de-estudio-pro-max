{
  "subagents": {
    "defaultModel": "gpt-5.6-terra",
    "agentOverrides": {
      "scout": {
        "model": "claude-sonnet-5",
        "thinking": "high",
        "fallbackModels": [
          "gpt-5.6-luna"
        ]
      },
      "planner": {
        "model": "gpt-5.6-sol",
        "thinking": "high",
        "fallbackModels": [
          "claude-opus-4-8"
        ]
      },
      "worker": {
        "model": "gpt-5.6-sol",
        "thinking": "high",
        "fallbackModels": [
          "claude-sonnet-5"
        ]
      },
      "reviewer": {
        "model": "claude-opus-4-8",
        "thinking": "high"
      },
      "oracle": {
        "model": "claude-opus-4-8",
        "thinking": "high",
        "fallbackModels": [
          "gpt-5.6-sol"
        ]
      },
      "context-builder": {
        "model": "gpt-5.6-sol",
        "thinking": "high",
        "fallbackModels": [
          "claude-opus-4-8"
        ]
      }
    },
    "watchdog": {
      "enabled": true,
      "model": "gpt-5.6-terra",
      "thinking": "high",
      "fallbackModels": [
        "claude-sonnet-5",
        "gpt-5.6-sol",
        "gpt-5.6-terra"
      ],
      "lsp": {
        "enabled": true,
        "timeoutMs": 5000,
        "maxFiles": 10,
        "maxDiagnostics": 50
      }
    }
  }
}